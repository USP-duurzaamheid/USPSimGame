@page "/create-user"
@rendermode InteractiveServer
@inject ILogger<Program> logger;

<PageTitle>Create User</PageTitle>

<p>Sample create user form</p>


<EditForm Model="Dto" OnSubmit="AddUser" FormName="Onnodig">
    <div>
        <label>
            Username:
            <InputText @bind-Value="Dto!.UserName"/>

        </label>

        <label>
            Password:
            <InputText @bind-Value="Dto!.Password" />

        </label>

        <label>
            Email:
            <InputText @bind-Value="Dto!.Email" />

        </label>

    </div>

    <div>
        <button type="submit">Submit</button>
    </div>


@if(SubmitMessage.Count() > 0)
    {
       @foreach (string message in SubmitMessage)
        {
            <p>@message</p>
        }

    }

</EditForm>



