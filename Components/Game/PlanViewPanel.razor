@namespace USPSimGame.Components.Game
@using USPSimGame.Data.Entities
@using USPSimGame.Services.Plans
@using USPSimGame.Services

<div class="plan-view-panel-container position-fixed bottom-0 end-0 m-3 z-3">
    <div class="card border-0 shadow-lg rounded-4 overflow-hidden plan-view-card" style="width: 380px; max-width: calc(100vw - 32px);">
        <!-- Header -->
        <div class="card-header bg-transparent border-bottom p-3 d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-2 overflow-hidden">
                <i class="bi bi-circle-fill fs-6" style="color: @(Plan.Team?.Color ?? "#3b82f6");" title="Proposed by @(Plan.Team?.Name ?? "Team")"></i>
                <h6 class="fw-bold text-dark mb-0 text-truncate">@Plan.Name</h6>
            </div>
            <button class="btn-close ms-2 flex-shrink-0" @onclick="CloseAsync" title="Close plan view"></button>
        </div>

        <div class="card-body p-3 overflow-auto" style="max-height: 420px;">
            <!-- State & Date row -->
            <div class="d-flex justify-content-between align-items-center mb-3">
                @if (CanChangeState)
                {
                    <div class="dropdown d-inline-block position-relative">
                        <button class="btn btn-sm badge font-monospace px-3 py-1 dropdown-toggle cursor-pointer border @GetStateBadgeClass(Plan.State)"
                                type="button" @onclick="ToggleDropdown" title="Click to change plan state">
                            @Plan.State
                        </button>
                        @if (IsDropdownOpen)
                        {
                            <ul class="dropdown-menu show shadow border-0 rounded-3 p-1 position-absolute top-100 start-0 z-3 mt-1" style="display: block; min-width: 170px;">
                                @foreach (PlanState stateOpt in GetAvailableStates())
                                {
                                    <li>
                                        <button type="button" class="dropdown-item rounded-2 small d-flex align-items-center justify-content-between py-1 @(stateOpt == Plan.State ? "fw-bold active" : "")"
                                                @onclick="() => ChangeStateAsync(stateOpt)">
                                            <span class="badge border font-monospace @GetStateBadgeClass(stateOpt)">@stateOpt</span>
                                            @if (stateOpt == Plan.State)
                                            {
                                                <i class="bi bi-check2 ms-2"></i>
                                            }
                                        </button>
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                }
                else
                {
                    <span class="badge border font-monospace px-3 py-1 @GetStateBadgeClass(Plan.State)">
                        @Plan.State
                    </span>
                }
                <span class="badge bg-light text-dark border font-monospace small">
                    <i class="bi bi-calendar-check text-primary me-1"></i>@FormatMonthYear(Plan.StartMonth)
                </span>
            </div>

            <!-- Spatial Evaluation Explanation Banner -->
            @if (Evaluation != null && !string.IsNullOrWhiteSpace(Evaluation.ExplanatoryText))
            {
                <div class="alert @(Evaluation.RequiresMultiTeamApproval ? "alert-warning" : "alert-success") py-2 px-3 mb-3 extra-small border-0 shadow-sm d-flex align-items-start gap-2">
                    <i class="bi @(Evaluation.RequiresMultiTeamApproval ? "bi-exclamation-triangle-fill text-warning" : "bi-check-circle-fill text-success") mt-1 fs-6"></i>
                    <div>@Evaluation.ExplanatoryText</div>
                </div>
            }

            <!-- Requested State Judgments Indicator -->
            @if (Plan.State == PlanState.Requested)
            {
                <div class="p-2.5 rounded-3 border mb-3 bg-light shadow-sm">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="fw-bold text-dark extra-small">
                            <i class="bi bi-people-fill text-primary me-1"></i>Team Judgments Status
                        </span>
                        <button type="button" class="btn btn-xs btn-outline-primary rounded-pill px-2 py-0.5 extra-small" @onclick="OpenJudgmentPanel">
                            <i class="bi bi-box-arrow-up-right me-1"></i>View Judgments
                        </button>
                    </div>

                    <div class="d-flex flex-wrap gap-1">
                        @foreach (var team in SessionTeams.Where(t => t.Id != Plan.TeamId))
                        {
                            var j = Judgments.FirstOrDefault(x => x.TeamId == team.Id);
                            var currentType = j?.Judgment ?? PlanJudgmentType.Undecided;
                            <span class="badge @GetJudgmentBadgeClass(currentType) border extra-small" title="@team.Name: @currentType">
                                <span style="display:inline-block; width:8px; height:8px; border-radius:50%; background-color:@team.Color;" class="me-1"></span>
                                @team.Name: @currentType
                            </span>
                        }
                    </div>

                    <!-- Confirmation Notice for Owning Team -->
                    @if (Plan.TeamId == CurrentTeamId)
                    {
                        @if (CanApprovePlan)
                        {
                            <div class="alert alert-success py-2 px-3 mt-2 mb-0 extra-small border-0 shadow-sm d-flex align-items-center justify-content-between">
                                <div><strong class="d-block">Set to Approved?</strong><span class="micro-text">All required teams approved or joined.</span></div>
                                <button type="button" class="btn btn-sm btn-success fw-bold ms-2" @onclick="() => ChangeStateAsync(PlanState.Approved)">Confirm Approval</button>
                            </div>
                        }
                        else if (HasRejections)
                        {
                            <div class="alert alert-danger py-2 px-3 mt-2 mb-0 extra-small border-0 shadow-sm d-flex align-items-center justify-content-between">
                                <div><strong class="d-block">Set to Archived?</strong><span class="micro-text">One or more teams rejected this plan.</span></div>
                                <button type="button" class="btn btn-sm btn-danger fw-bold ms-2" @onclick="() => ChangeStateAsync(PlanState.Archived)">Confirm Archive</button>
                            </div>
                        }
                    }
                </div>
            }

            <p class="text-muted small mb-3">
                @(string.IsNullOrWhiteSpace(Plan.Description) ? "No plan description provided." : Plan.Description)
            </p>

            @if (IsLockedByOther)
            {
                <div class="alert alert-warning border-0 rounded-3 p-2 small mb-3 d-flex align-items-center gap-2" title="Plan is currently locked by @(Plan.LockedByUserName ?? "another player")">
                    <i class="bi bi-lock-fill text-warning fs-5"></i>
                    <div>
                        <strong class="d-block">Currently Locked for Editing</strong>
                        <span class="micro-text">Being edited by <strong>@(Plan.LockedByUserName ?? "another player")</strong></span>
                    </div>
                </div>
            }

            <h6 class="fw-bold text-dark small mb-2">
                <i class="bi bi-diagram-2 me-1 text-success"></i>Included Developments (@Plan.Features.Count)
            </h6>

            <div class="d-flex flex-column gap-2">
                @foreach (var feat in Plan.Features)
                {
                    bool isSelected = (SelectedFeature == feat);

                    <PlanFeatureRow Definition="@feat.GameSessionPlannableLayer?.PlannableLayerDefinition"
                                    GeoJsonGeometry="@feat.GeoJsonGeometry"
                                    IsDemolition="@feat.IsDemolition"
                                    IsActive="@isSelected"
                                    OnSelect="() => SelectFeatureForHighlightAsync(feat)" />
                }
            </div>
        </div>

        <div class="card-footer bg-transparent border-top p-3 d-flex justify-content-between align-items-center">
            <div>
                @if (CanEdit)
                {
                    <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3" @onclick="EditPlanAsync">
                        <i class="bi bi-pencil-square me-1"></i>Edit Spatial Plan
                    </button>
                }
            </div>
            <button type="button" class="btn btn-sm btn-secondary rounded-pill px-4" @onclick="CloseAsync">
                Close
            </button>
        </div>
    </div>
</div>

<!-- Plan Judgment Side Panel -->
<PlanJudgmentPanel @bind-IsOpen="IsJudgmentPanelOpen"
                   TargetPlan="Plan"
                   SessionTeams="SessionTeams"
                   OnJudgmentsUpdated="HandleJudgmentsUpdated" />
