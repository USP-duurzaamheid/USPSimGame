@namespace USPSimGame.Components.Game.Menu
@using USPSimGame.Components.Game.Dilemmas
@using USPSimGame.Components.Game.Simulation

<nav class="game-menu" aria-label="Spelmenu">
    <button type="button" class="game-menu-button" @onclick="OpenOverview">
        <i class="bi bi-bar-chart-line-fill" aria-hidden="true"></i>
        <span>Overzicht</span>
    </button>

    @if (ShowDilemmas)
    {
        <button type="button" class="game-menu-button @(ActiveSlot == MenuSlot.Dilemmas ? "game-menu-button--active" : null)"
                aria-pressed="@(ActiveSlot == MenuSlot.Dilemmas ? "true" : "false")"
                @onclick="() => ToggleSlot(MenuSlot.Dilemmas)">
            <i class="bi bi-bullseye" aria-hidden="true"></i>
            <span>Doelen</span>
            @if (AttentionCount > 0)
            {
                <span class="game-menu-badge" title="@AttentionCount doel(en) met een deadline die deze maand afloopt of gemist is">@AttentionCount</span>
            }
        </button>
    }

    <button type="button" class="game-menu-button @(ActiveSlot == MenuSlot.Buildings ? "game-menu-button--active" : null)"
            aria-pressed="@(ActiveSlot == MenuSlot.Buildings ? "true" : "false")"
            disabled="@(!BuildingsEnabled)"
            title="@(BuildingsEnabled ? "Ontwikkelplannen" : "Beschikbaar na de setup-fase")"
            @onclick="() => ToggleSlot(MenuSlot.Buildings)">
        <i class="bi bi-building-fill" aria-hidden="true"></i>
        <span>BUILDINGS</span>
    </button>
</nav>

@if (ActiveSlot == MenuSlot.Dilemmas)
{
    <div class="game-menu-slot">
        <ActiveDilemmasPanel Dilemmas="Dilemmas" CurrentMonth="CurrentMonth" StartYear="StartYear"
                             IsPreview="IsPreview" OnClose="CloseSlot" />
    </div>
}
else if (ActiveSlot == MenuSlot.Buildings && Buildings != null)
{
    <div class="game-menu-slot game-menu-slot--buildings">
        @Buildings
    </div>
}

@if (ShowOverview)
{
    <KpiChartModal GameSessionId="GameSessionId" ScopeTeamId="ScopeTeamId" StartYear="StartYear" OnClose="CloseOverview" />
}
