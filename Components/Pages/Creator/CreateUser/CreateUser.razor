@page "/create-user"
@rendermode InteractiveServer


@inject ILogger<Program> logger;

<PageTitle>Create User</PageTitle>

@if(LoginBool == false)
{
<p>Sample create user form</p>
  <EditForm Model="Dto" OnSubmit="AddUser" FormName="CreateUser">
    <div>
        <label>
            Username:
            <InputText @bind-Value="Dto!.UserName"/>

        </label>

        <label>
            Password:
            <InputText @bind-Value="Dto!.Password" />

        </label>

        <label>
            Email:
            <InputText @bind-Value="Dto!.Email" />

        </label>

    </div>

    <div>
        <button type="submit">Submit</button>
    </div>
    </EditForm> 

@if(SubmitMessage.Count() > 0)
    {
       @foreach (string message in SubmitMessage)
        {
            <p>@message</p>
        }

    }
} else
{
    <p>Account sucessfully created, you will be redirected in a few seconds</p>
}

