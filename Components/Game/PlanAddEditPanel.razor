@namespace USPSimGame.Components.Game
@using USPSimGame.Data.Entities

<div class="plan-add-edit-panel-container position-fixed bottom-0 end-0 m-3 z-3">
    <div class="card border-0 shadow-lg rounded-4 overflow-hidden plan-add-edit-card" style="width: 380px; max-width: calc(100vw - 32px);">
        <!-- Header -->
        <div class="card-header @(IsEditMode ? "bg-primary" : "bg-success") text-white p-3 d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-2">
                <i class="bi @(IsEditMode ? "bi-pencil-fill" : "bi-plus-circle-fill") h5 mb-0"></i>
                <h6 class="fw-bold mb-0">@(IsEditMode ? $"Edit Development Plan #{PlanToEdit!.Id}" : "Create Development Plan")</h6>
            </div>
            <button class="btn-close btn-close-white" @onclick="CancelAsync"></button>
        </div>

        <div class="card-body p-3 overflow-auto" style="max-height: 480px;">
            @if (ErrorMessage != null)
            {
                <div class="alert alert-danger border-0 small rounded-3 p-2 mb-3">
                    <i class="bi bi-exclamation-circle me-1"></i>@ErrorMessage
                </div>
            }
            @if (RealtimeEvaluation != null && !string.IsNullOrWhiteSpace(RealtimeEvaluation.ExplanatoryText))
            {
                <div class="alert @(RealtimeEvaluation.RequiresMultiTeamApproval ? "alert-warning" : "alert-info") py-2 px-3 mb-3 extra-small border-0 shadow-sm d-flex align-items-start gap-2">
                    <i class="bi @(RealtimeEvaluation.RequiresMultiTeamApproval ? "bi-exclamation-triangle-fill text-warning" : "bi-info-circle-fill text-info") mt-1 fs-6"></i>
                    <div>@RealtimeEvaluation.ExplanatoryText</div>
                </div>
            }

            @if (IsLoading)
            {
                <div class="text-center py-4">
                    <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                    <span class="ms-2 text-muted small">Loading plannable layers...</span>
                </div>
            }
            else if (!SessionPlannableLayers.Any())
            {
                <div class="alert alert-warning border-0 rounded-3 small">
                    <i class="bi bi-exclamation-triangle me-1"></i>No plannable layers are attached to this game session. Ask the session creator to attach plannable layers.
                </div>
            }
            else
            {
                <div class="d-flex flex-column gap-3">
                    <div>
                        <label class="form-label fw-bold text-dark small mb-1">Plan Name</label>
                        <input type="text" class="form-control form-control-sm" @bind="PlanName" placeholder="e.g. Science Park Solar Expansion" required />
                    </div>

                    <div>
                        <label class="form-label fw-bold text-dark small mb-1">Description</label>
                        <textarea class="form-control form-control-sm" rows="2" @bind="Description" placeholder="Optional notes or plan description..."></textarea>
                    </div>

                    @if (CalculatedConstructionMonths > 0)
                    {
                    <!-- Dynamic Construction Time Banner -->
                    <div class="alert @(IsConstructionTimeValid ? "alert-info" : "alert-danger") border-0 py-2 px-3 mb-1 extra-small shadow-sm">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi @(IsConstructionTimeValid ? "bi-tools text-info" : "bi-exclamation-triangle-fill text-danger") fs-6"></i>
                            <div>
                                <strong>Construction Duration: @CalculatedConstructionMonths month(s)</strong>
                                <div class="text-muted">
                                    Construction starts: <strong>@USPSimGame.Utils.CommonGameUtils.FormatMonthYear(((SelectedYear - StartYear) * 12) + (SelectedMonth - 1) - CalculatedConstructionMonths, StartYear)</strong>
                                </div>
                            </div>
                        </div>
                    </div>
                    }

                    <div>
                        <label class="form-label fw-bold text-dark small mb-1">Implementation Target Date</label>
                        <div class="row g-2">
                            <div class="col-6">
                                <select class="form-select form-select-sm" @bind="SelectedMonth">
                                    @for (int m = 1; m <= 12; m++)
                                    {
                                        int testMonth = ((SelectedYear - StartYear) * 12) + (m - 1);
                                        bool isDisabled = testMonth < MinimumAllowedCompletionMonth;
                                        <option value="@m" disabled="@isDisabled">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(m)</option>
                                    }
                                </select>
                            </div>
                            <div class="col-6">
                                <select class="form-select form-select-sm" @bind="SelectedYear">
                                    @for (int yr = StartYear; yr <= StartYear + 30; yr++)
                                    {
                                        <option value="@yr">@yr</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- Catalog Button -->
                    <div class="mb-3">
                        <button type="button" class="btn btn-sm btn-outline-success w-100 rounded-pill py-2 fw-bold shadow-sm d-flex align-items-center justify-content-center gap-2"
                                @onclick="OpenCatalogModal">
                            <i class="bi bi-grid-3x3-gap-fill h6 mb-0"></i>
                            <span>Browse & Add Development Option</span>
                        </button>
                    </div>

                    <!-- Section A: Included Layers -->
                    <div class="mb-3">
                        <label class="form-label fw-bold text-dark small mb-1">
                            <i class="bi bi-folder-check text-primary me-1"></i>Included Options (@IncludedLayers.Count)
                        </label>
                        @if (!IncludedLayers.Any())
                        {
                            <div class="text-muted extra-small fst-italic p-2.5 rounded-3 border border-dashed bg-light text-center">
                                Nothing included yet.
                            </div>
                        }
                        else
                        {
                            <div class="d-flex flex-column gap-2">
                                @foreach (var layer in IncludedLayers)
                                {
                                    bool isSelected = (SelectedPlannableLayerId == layer.Id && SelectedDevelopmentFeature == null);
                                    var def = layer.PlannableLayerDefinition;

                                    <div class="p-2.5 rounded-3 border transition-all @(isSelected ? "border-success bg-success-subtle shadow-sm" : "bg-white hover-bg-light cursor-pointer")">
                                        <div class="d-flex align-items-center justify-content-between" @onclick="() => SelectLayerForDrawingAsync(layer.Id)">
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="rounded-circle p-1 d-flex align-items-center justify-content-center text-white shadow-sm" style="background-color: @(def?.DefaultColor ?? "#3b82f6"); width: 26px; height: 26px;">
                                                    <i class="bi @(def?.Icon ?? "bi-layers-fill") micro-text"></i>
                                                </div>
                                                <div>
                                                    <span class="fw-semibold text-dark small">@(def?.Name ?? "Layer")</span>
                                                    <span class="badge bg-warning-subtle text-dark border border-warning-subtle micro-text ms-1">@(def?.GeometryType)</span>
                                                </div>
                                            </div>
                                            <div class="d-flex align-items-center gap-2">
                                                @if (isSelected)
                                                {
                                                    <span class="badge bg-success text-white micro-text">Active</span>
                                                }
                                                <button type="button" class="btn btn-sm btn-outline-danger p-0 px-2 action-btn-small"
                                                        @onclick:stopPropagation="true"
                                                        @onclick="() => RemoveLayerFromPlanAsync(layer.Id)"
                                                        title="Remove this layer and all its developments from the plan">
                                                    <i class="bi bi-x-lg"></i>
                                                </button>
                                            </div>
                                        </div>

                                        <!-- Section B: Inline GeometryDrawControls for the Selected Active Layer -->
                                        @if (isSelected && def != null)
                                        {
                                            <div class="mt-2 pt-2 border-top">
                                                <GeometryDrawControls LayerName="@def.Name"
                                                                      GeometryType="@def.GeometryType.ToString()"
                                                                      Category="@def.Category.ToString()"
                                                                      Color="@(def.DefaultColor ?? "#3b82f6")"
                                                                      Icon="@(def.Icon ?? "bi-layers-fill")"
                                                                      IsActive="true"
                                                                      OnUndoPoint="UndoPointAsync"
                                                                      OnRedoPoint="RedoPointAsync"
                                                                      OnDeletePoint="DeletePointAsync" />
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    <!-- Section C: Included Developments (Ledger of Real Items) -->
                    @{
                        var activeFeatureItems = DraftFeatures.Where(f => !string.IsNullOrWhiteSpace(f.GeoJsonGeometry)).ToList();
                    }
                    @if (activeFeatureItems.Any())
                    {
                        <div class="mb-3">
                            <label class="form-label fw-bold text-dark small mb-1">
                                <i class="bi bi-diagram-2 text-success me-1"></i>Included Developments (@activeFeatureItems.Count)
                            </label>
                            <div class="d-flex flex-column gap-2">
                                @foreach (var featureItem in activeFeatureItems)
                                {
                                    bool isSelectedFeature = (SelectedDevelopmentFeature == featureItem);

                                    <PlanFeatureRow Definition="@featureItem.Layer?.PlannableLayerDefinition"
                                                    GeoJsonGeometry="@featureItem.GeoJsonGeometry"
                                                    IsDemolition="@featureItem.IsDemolition"
                                                    IsActive="@isSelectedFeature"
                                                    ShowRemoveButton="true"
                                                    OnSelect="() => SelectDevelopmentFeatureForHighlightAsync(featureItem)"
                                                    OnRemove="() => RemoveDevelopmentFeatureAsync(featureItem)" />
                                }
                            </div>
                        </div>
                    }

                    <!-- Section D: Financial Summary Card -->
                    @if (CurrentPlanCost.TotalInvestmentPoints != 0 || CurrentPlanCost.TotalMonthlyExpensePoints != 0)
                    {
                        <div class="card border-0 bg-success-subtle p-3 rounded-3 mb-3">
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <span class="fw-bold text-success small"><i class="bi bi-cash-stack me-1"></i>Financial Cost Summary</span>
                            </div>
                            <div class="d-flex justify-content-between small mb-1">
                                <span>Investment:</span>
                                <strong class="text-danger">⚡ -@CurrentPlanCost.TotalInvestmentPoints pts</strong>
                            </div>
                            <div class="d-flex justify-content-between small mb-1">
                                <span>Expense:</span>
                                @if (CurrentPlanCost.TotalMonthlyExpensePoints < 0)
                                {
                                    <strong class="text-success">📈 +@Math.Abs(CurrentPlanCost.TotalMonthlyExpensePoints) pts/mo (savings)</strong>
                                }
                                else
                                {
                                    <strong class="text-danger">📉 -@CurrentPlanCost.TotalMonthlyExpensePoints pts/mo</strong>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="card-footer bg-transparent border-top p-3 d-flex justify-content-end gap-2">
            <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3" @onclick="CancelAsync" disabled="@IsSaving">
                Cancel
            </button>
            <button type="button" class="btn btn-sm @(IsEditMode ? "btn-primary" : "btn-success") rounded-pill px-4" @onclick="SavePlanAsync" disabled="@(IsSaving || !SessionPlannableLayers.Any() || !IsConstructionTimeValid)">
                @if (IsSaving)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                    <span>Saving...</span>
                }
                else
                {
                    <span><i class="bi @(IsEditMode ? "bi-check2-circle" : "bi-check-circle") me-1"></i>@(IsEditMode ? "Save Plan Edits" : "Save Development Plan")</span>
                }
            </button>
        </div>
    </div>
</div>

<PlannableLayerCatalogModal @bind-IsOpen="_isCatalogModalOpen"
                            AvailableLayers="SessionPlannableLayers"
                            IncludedLayerIds="_includedLayerIdsSet"
                            SelectedLayerId="SelectedPlannableLayerId"
                            OnLayerSelected="OnCatalogLayerSelectedAsync" />
