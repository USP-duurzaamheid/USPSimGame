@namespace USPSimGame.Components.Creator.Auth

<div class="login-card-container">
    <div class="card shadow-lg login-card">
        <div class="card-header text-center bg-primary text-white py-3">
            <h4 class="mb-0"><i class="bi bi-person-plus me-2"></i>Create Creator Account</h4>
        </div>
        <div class="card-body p-4">
            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>@ErrorMessage
                </div>
            }

            <EditForm Model="@this" OnValidSubmit="HandleRegister">
                <div class="mb-3">
                    <label for="reg-username" class="form-label font-weight-bold">Username</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-person"></i></span>
                        <input id="reg-username" type="text" class="form-control" placeholder="Choose a username" autocomplete="username" @bind="Username" required />
                    </div>
                </div>

                <div class="mb-3">
                    <label for="reg-email" class="form-label font-weight-bold">Email</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                        <input id="reg-email" type="email" class="form-control" placeholder="name@example.com" autocomplete="email" @bind="Email" required />
                    </div>
                </div>

                <div class="mb-3">
                    <label for="reg-password" class="form-label font-weight-bold">Password</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-key"></i></span>
                        <input id="reg-password" type="password" class="form-control" placeholder="At least @MinPasswordLength characters" autocomplete="new-password" @bind="Password" required />
                    </div>
                </div>

                <div class="mb-4">
                    <label for="reg-confirm-password" class="form-label font-weight-bold">Confirm Password</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-key-fill"></i></span>
                        <input id="reg-confirm-password" type="password" class="form-control" placeholder="Repeat password" autocomplete="new-password" @bind="ConfirmPassword" required />
                    </div>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2 font-weight-bold" disabled="@IsLoading">
                    @if (IsLoading)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                        <span>Creating account...</span>
                    }
                    else
                    {
                        <span><i class="bi bi-person-check me-2"></i>Register</span>
                    }
                </button>
            </EditForm>

            <div class="text-center mt-3">
                <span class="text-muted">Already have an account?</span>
                <button type="button" class="btn btn-link p-0 ms-1 align-baseline" @onclick="OnShowLogin">Log in</button>
            </div>
        </div>
    </div>
</div>
