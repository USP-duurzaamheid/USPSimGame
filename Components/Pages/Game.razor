@page "/game"
@using USPSimGame.Components.Game
@using USPSimGame.Data.Enums
@rendermode InteractiveServer

<PageTitle>Game - @(PlayerSessionState.CurrentGameSession?.Name ?? "Simulation")</PageTitle>

@if (!PlayerSessionState.IsConnected)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Checking session...</span>
        </div>
        <p class="text-muted mt-2">Verifying game connection...</p>
    </div>
}
else
{
    <ControlBar />

    <!-- Bottom-Left Insight Burger Menu: Overzicht (KPI charts), Doelen (dilemmas), BUILDINGS (development plans) -->
    <InsightBurgerMenu @ref="insightBurgerMenu"
                       GameSessionId="@(PlayerSessionState.CurrentGameSession?.Id ?? 0)"
                       ScopeTeamId="@(PlayerSessionState.IsAdmin ? null : PlayerSessionState.CurrentTeam?.Id)"
                       StartYear="@(PlayerSessionState.CurrentGameSession?.StartYear ?? 2026)"
                       CurrentMonth="@(PlayerSessionState.CurrentGameSession?.CurrentMonth ?? 0)"
                       ShowDilemmas="@(!PlayerSessionState.IsAdmin)"
                       Dilemmas="@Dilemmas"
                       NewDilemmaCode="@NewDilemmaCode"
                       IsPreview="true"
                       BuildingsEnabled="@(PlayerSessionState.CurrentGameSession?.State is not null and not GameState.Setup)">
        <Buildings>
            <!-- Development Plans Panel -->
            <PlansControlPanel @ref="plansControlPanel"
                               GameSessionId="@(PlayerSessionState.CurrentGameSession?.Id ?? 0)"
                               CurrentTeamId="@(PlayerSessionState.CurrentTeam?.Id ?? 0)"
                               GameState="@(PlayerSessionState.CurrentGameSession?.State ?? GameState.Setup)"
                               IsAdmin="@PlayerSessionState.IsAdmin"
                               StartYear="@(PlayerSessionState.CurrentGameSession?.StartYear ?? 2026)"
                               ActivePlan="@ActivePlan"
                               IsCollapsed="false"
                               OnToggleCollapse="CloseMenuPanelWhenCollapsed"
                               OnOpenNewPlan="OpenNewPlanPanel"
                               OnPlanSelected="HandlePlanSelectedAsync" />
        </Buildings>
    </InsightBurgerMenu>

    <!-- Top-Right: Map Layers & Legend Panel (below the control bar) -->
    <div class="game-map-layers">
        <LayerControls GameSessionId="@(PlayerSessionState.CurrentGameSession?.Id ?? 0)"
                       IsCollapsed="@isMapPanelCollapsed"
                       OnToggleCollapse="HandleMapPanelToggle" />
    </div>

    <!-- Team Area Definition Panel (Bottom Right during Setup State for Players) -->
    @if (!PlayerSessionState.IsAdmin && PlayerSessionState.CurrentGameSession?.State == GameState.Setup && !ShowPlanAddEditPanel && ActivePlan == null && PlayerSessionState.CurrentTeam != null)
    {
        <TeamAreaPanel GameSessionId="@(PlayerSessionState.CurrentGameSession?.Id ?? 0)"
                       Team="@PlayerSessionState.CurrentTeam"
                       CurrentPlayerSessionId="@(PlayerSessionState.CurrentPlayerSession?.Id ?? 0)" />
    }

    <!-- Plan Add & Edit Panel (Bottom Right) -->
    @if (!PlayerSessionState.IsAdmin && ShowPlanAddEditPanel)
    {
        <PlanAddEditPanel GameSessionId="@(PlayerSessionState.CurrentGameSession?.Id ?? 0)"
                          TeamId="@(PlayerSessionState.CurrentTeam?.Id ?? 0)"
                          CurrentPlayerSessionId="@(PlayerSessionState.CurrentPlayerSession?.Id ?? 0)"
                          StartYear="@(PlayerSessionState.CurrentGameSession?.StartYear ?? 2026)"
                          PlanToEdit="@PlanToEdit"
                          OnSaved="HandlePlanSavedAsync"
                          OnCancel="ClosePlanAddEditPanelAsync" />
    }

    <!-- Plan View Panel (Bottom Right) -->
    @if (ActivePlan != null)
    {
        <PlanViewPanel Plan="@ActivePlan"
                       StartYear="@(PlayerSessionState.CurrentGameSession?.StartYear ?? 2026)"
                       CurrentTeamId="@(PlayerSessionState.CurrentTeam?.Id ?? 0)"
                       CurrentPlayerSessionId="@(PlayerSessionState.CurrentPlayerSession?.Id ?? 0)"
                       IsAdmin="@PlayerSessionState.IsAdmin"
                       SessionTeams="@SessionTeams"
                       OnEditPlan="HandleEditPlanAsync"
                       OnClose="ClosePlanViewAsync" />
    }

    <!-- New Dilemma Pop-up -->
    @if (IncomingDilemma != null)
    {
        <DilemmaPopup Dilemma="@IncomingDilemma"
                      CurrentMonth="@(PlayerSessionState.CurrentGameSession?.CurrentMonth ?? 0)"
                      StartYear="@(PlayerSessionState.CurrentGameSession?.StartYear ?? 2026)"
                      OnClose="CloseIncomingDilemma"
                      OnViewGoals="ViewIncomingDilemma" />
    }

    <!-- Map Geometry Properties Floating Panel -->
    <MapFeaturePropertiesPanel @ref="propertiesPanel" />

    <!-- OpenLayers Base Map -->
    <GameBaseMap InitialCenter="@InitialCenter" InitialZoom="@InitialZoom" />
}
