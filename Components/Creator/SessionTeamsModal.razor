@namespace USPSimGame.Components.Creator
@using USPSimGame.Data.Entities

<div class="modal fade show d-block modal-backdrop-custom" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header border-bottom pb-3">
                <div>
                    <h5 class="modal-title fw-bold text-dark">
                        <i class="bi bi-people-fill text-primary me-2"></i>Session Teams Management
                    </h5>
                    <small class="text-muted">Session #@Session.Id - <strong>@Session.Name</strong></small>
                </div>
                <button type="button" class="btn-close" @onclick="CloseAsync"></button>
            </div>
            <div class="modal-body p-4">

                <!-- Alert Messages -->
                @if (!string.IsNullOrEmpty(PresetErrorMessage))
                {
                    <div class="alert alert-danger alert-dismissible fade show rounded-3 small mb-4" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>@PresetErrorMessage
                        <button type="button" class="btn-close" @onclick="() => PresetErrorMessage = null"></button>
                    </div>
                }
                @if (!string.IsNullOrEmpty(PresetSuccessMessage))
                {
                    <div class="alert alert-success alert-dismissible fade show rounded-3 small mb-4" role="alert">
                        <i class="bi bi-check-circle-fill me-2"></i>@PresetSuccessMessage
                        <button type="button" class="btn-close" @onclick="() => PresetSuccessMessage = null"></button>
                    </div>
                }

                <!-- Import Team Preset Section -->
                @if (AvailablePresets.Any())
                {
                    <div class="card border-0 bg-light p-3 rounded-3 mb-4 border">
                        <h6 class="fw-bold text-dark mb-1">
                            <i class="bi bi-box-arrow-in-down text-primary me-1"></i>Import Team Preset
                        </h6>
                        <p class="small text-muted mb-3">Click a preset below to populate pre-configured team definitions and territory geometries for this session.</p>
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var preset in AvailablePresets)
                            {
                                <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-semibold d-flex align-items-center gap-1"
                                        disabled="@IsImportingPreset"
                                        @onclick="() => ImportPresetAsync(preset.FilePath)">
                                    @if (IsImportingPreset)
                                    {
                                        <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-download"></i>
                                    }
                                    <span>@preset.DisplayName</span>
                                </button>
                            }
                        </div>
                    </div>
                }

                <!-- Add Team Form -->
                <div class="card border-0 bg-light p-3 rounded-3 mb-4 border">
                    <h6 class="fw-bold text-dark mb-3">
                        <i class="bi bi-person-plus-fill me-1 text-primary"></i>Add New Team to Session
                    </h6>
                    <div class="row g-2">
                        <div class="col-12 col-md-4">
                            <label class="form-label small fw-bold mb-1">Team Name</label>
                            <input type="text" class="form-control form-control-sm" placeholder="e.g. Energy Grid Team" @bind="NewTeamName" />
                        </div>
                        <div class="col-12 col-md-3">
                            <label class="form-label small fw-bold mb-1">Password / PIN</label>
                            <input type="password" class="form-control form-control-sm" placeholder="e.g. secret123" @bind="NewTeamPassword" />
                        </div>
                        <div class="col-12 col-md-2">
                            <label class="form-label small fw-bold mb-1">Color</label>
                            <div class="d-flex gap-2 align-items-center">
                                <input type="color" class="form-control form-control-color form-control-sm" @bind="NewTeamColor" />
                                <input type="text" class="form-control form-control-sm font-monospace" @bind="NewTeamColor" />
                            </div>
                        </div>
                        <div class="col-12 col-md-3">
                            <label class="form-label small fw-bold mb-1">Annual Budget</label>
                            <input type="number" class="form-control form-control-sm" @bind="NewTeamAnnualBudgetAllowance" />
                        </div>
                    </div>
                    <div class="mt-3 text-end">
                        <button class="btn btn-sm btn-primary rounded-pill px-3" disabled="@(string.IsNullOrWhiteSpace(NewTeamName) || string.IsNullOrWhiteSpace(NewTeamPassword))" @onclick="AddTeamToSessionAsync">
                            <i class="bi bi-plus-lg me-1"></i>Add Team
                        </button>
                    </div>
                </div>

                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h6 class="fw-bold text-dark mb-0">
                        <i class="bi bi-shield-lock me-1"></i>Configured Session Teams (@SessionTeams.Count)
                    </h6>
                    @if (SessionTeams.Any())
                    {
                        <button type="button" class="btn btn-sm btn-outline-success rounded-pill px-3" @onclick="ToggleExportForm">
                            <i class="bi bi-box-arrow-up me-1"></i>Export Teams to Preset
                        </button>
                    }
                </div>

                @if (ShowExportForm)
                {
                    <div class="card border-0 bg-success bg-opacity-10 p-3 rounded-3 mb-3 border border-success">
                        <h6 class="fw-bold text-success mb-2">
                            <i class="bi bi-file-earmark-arrow-up me-1"></i>Export Teams to Preset File
                        </h6>
                        <div class="row g-2 align-items-end">
                            <div class="col-12 col-md-8">
                                <label class="form-label small fw-bold mb-1">Preset Name</label>
                                <input type="text" class="form-control form-control-sm" placeholder="e.g. Utrecht Science Park" @bind="ExportPresetName" />
                            </div>
                            <div class="col-12 col-md-4 text-end">
                                <button type="button" class="btn btn-sm btn-success rounded-pill px-3 me-1"
                                        disabled="@(string.IsNullOrWhiteSpace(ExportPresetName) || IsExportingPreset)"
                                        @onclick="ExportTeamsToPresetAsync">
                                    @if (IsExportingPreset)
                                    {
                                        <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-check-lg me-1"></i>
                                    }
                                    Export
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3" @onclick="ToggleExportForm">
                                    Cancel
                                </button>
                            </div>
                        </div>
                    </div>
                }

                @if (IsLoading)
                {
                    <div class="text-center py-4">
                        <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                        <span class="ms-2 text-muted">Loading teams...</span>
                    </div>
                }
                else if (!SessionTeams.Any())
                {
                    <div class="alert alert-secondary border-0 rounded-3 text-center py-3">
                        <i class="bi bi-people me-2 text-muted"></i>No teams added to this session yet. Create teams above or import a preset.
                    </div>
                }
                else
                {
                    <div class="table-responsive border rounded-3 bg-white">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light small">
                                <tr>
                                    <th>Team Name</th>
                                    <th style="width: 140px;">Color</th>
                                    <th style="width: 180px;">Password</th>
                                    <th style="width: 150px;">Annual Budget</th>
                                    <th class="text-end" style="width: 110px;">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var team in SessionTeams)
                                {
                                    @if (EditingTeamId == team.Id)
                                    {
                                        <tr class="table-primary bg-opacity-10">
                                            <td>
                                                <input type="text" class="form-control form-control-sm fw-bold" @bind="EditingTeamName" placeholder="Team Name" />
                                            </td>
                                            <td>
                                                <div class="d-flex gap-1 align-items-center">
                                                    <input type="color" class="form-control form-control-color form-control-sm p-0 border-0" @bind="EditingTeamColor" style="width: 28px; height: 28px;" />
                                                    <input type="text" class="form-control form-control-sm font-monospace" @bind="EditingTeamColor" style="width: 75px;" />
                                                </div>
                                            </td>
                                            <td>
                                                <input type="password" class="form-control form-control-sm" @bind="EditingTeamPassword" placeholder="New Password (optional)" />
                                            </td>
                                            <td>
                                                <input type="number" class="form-control form-control-sm" @bind="EditingTeamAnnualBudgetAllowance" />
                                            </td>
                                            <td class="text-end">
                                                <div class="btn-group btn-group-sm">
                                                    <button type="button" class="btn btn-success py-0 px-2" disabled="@string.IsNullOrWhiteSpace(EditingTeamName)" @onclick="SaveEditedTeamAsync" title="Save changes">
                                                        <i class="bi bi-check-lg"></i>
                                                    </button>
                                                    <button type="button" class="btn btn-outline-secondary py-0 px-2" @onclick="CancelEditTeam" title="Cancel edit">
                                                        <i class="bi bi-x-lg"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                    else
                                    {
                                        <tr>
                                            <td>
                                                <div class="d-flex align-items-center gap-2">
                                                    <span class="rounded-circle d-inline-block team-color-dot" style="background-color: @team.Color;"></span>
                                                    <strong class="text-dark">@team.Name</strong>
                                                </div>
                                            </td>
                                            <td><code class="small text-muted">@team.Color</code></td>
                                            <td><span class="text-muted small">••••••••</span></td>
                                            <td><span class="text-dark small">@team.AnnualBudgetAllowance</span></td>
                                            <td class="text-end">
                                                <div class="btn-group btn-group-sm">
                                                    <button type="button" class="btn btn-outline-primary py-0 px-2 action-btn-small" @onclick="() => StartEditTeam(team)" title="Edit team definition">
                                                        <i class="bi bi-pencil"></i>
                                                    </button>
                                                    <button type="button" class="btn btn-outline-danger py-0 px-2 action-btn-small" @onclick="() => DeleteTeamFromSessionAsync(team.Id)" title="Delete team">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
            <div class="modal-footer border-top pt-3">
                <button type="button" class="btn btn-secondary rounded-pill px-4" @onclick="CloseAsync">Close</button>
            </div>
        </div>
    </div>
</div>
