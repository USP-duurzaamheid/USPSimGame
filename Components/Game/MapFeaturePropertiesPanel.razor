@namespace USPSimGame.Components.Game
@using USPSimGame.Data.Models

@if (IsOpen)
{
    <div id="map-feature-properties-panel" class="map-properties-panel-container position-fixed z-3"
         style="top: @(TopPx)px; left: @(LeftPx)px; width: 340px; max-width: calc(100vw - 32px);">
        <div class="card border-0 shadow-lg rounded-4 overflow-hidden bg-white border border-secondary border-opacity-25">
            <!-- Draggable Panel Header -->
            <div class="card-header bg-dark text-white p-3 d-flex align-items-center justify-content-between cursor-move"
                 @onmousedown="StartDrag">
                <div class="d-flex align-items-center gap-2 text-truncate me-2">
                    <span class="badge rounded-circle p-2 d-flex align-items-center justify-content-center"
                          style="background-color: @(SelectedFeature?.Color ?? "#3b82f6"); width: 28px; height: 28px;">
                        <i class="bi bi-table micro-text text-white"></i>
                    </span>
                    <div>
                        <h6 class="fw-bold mb-0 text-truncate text-white small">
                            @(SelectedFeature != null ? SelectedFeature.LayerName : $"{Candidates.Count} Features Found")
                        </h6>
                        <small class="text-white-50 extra-small">
                            @(SelectedFeature != null ? SelectedFeature.Category : "Click to inspect")
                        </small>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-1">
                    @if (Candidates.Count > 1 && SelectedFeature != null)
                    {
                        <button type="button" class="btn btn-sm btn-outline-light py-0 px-2 extra-small rounded-pill me-1" @onclick="BackToCandidateList" title="Back to feature list">
                            <i class="bi bi-list me-1"></i>List
                        </button>
                    }
                    <button type="button" class="btn-close btn-close-white btn-sm" @onclick="ClosePanel" title="Close properties panel"></button>
                </div>
            </div>

            <!-- Panel Content Body -->
            <div class="card-body p-3 overflow-auto" style="max-height: 420px;">
                @if (SelectedFeature == null && Candidates.Count > 1)
                {
                    <!-- Multiple Candidate Features List -->
                    <div class="text-uppercase text-muted fw-bold extra-small mb-2">
                        Select Geometry to Inspect:
                    </div>
                    <div class="list-group list-group-flush border rounded-3 overflow-hidden">
                        @foreach (var candidate in Candidates)
                        {
                            <button type="button"
                                    class="list-group-item list-group-item-action d-flex align-items-center justify-content-between p-2"
                                    @onclick="() => SelectCandidate(candidate)">
                                <div class="d-flex align-items-center gap-2 overflow-hidden me-2">
                                    <span class="badge rounded-circle p-1" style="background-color: @candidate.Color; width: 10px; height: 10px;"></span>
                                    <div class="text-truncate">
                                        <div class="fw-semibold text-dark small text-truncate">@candidate.LayerName</div>
                                        <span class="badge bg-secondary-subtle text-secondary extra-small">@candidate.Category</span>
                                    </div>
                                </div>
                                <i class="bi bi-chevron-right text-muted small"></i>
                            </button>
                        }
                    </div>
                }
                else if (SelectedFeature != null)
                {
                    @if (SelectedFeature.IsEditable)
                    {
                        <!-- Editable Properties View (Plan Drafting Mode) -->
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="badge bg-warning-subtle text-dark border border-warning-subtle extra-small">
                                <i class="bi bi-pencil-fill me-1 text-warning"></i>Editable Plan Geometry
                            </span>
                            <button type="button" class="btn btn-sm btn-outline-primary py-0 px-2 extra-small rounded-pill" @onclick="AddVariableRow">
                                <i class="bi bi-plus-lg me-1"></i>Add Attribute
                            </button>
                        </div>

                        @if (!SelectedFeature.CustomEntries.Any())
                        {
                            <div class="text-center py-3 bg-light rounded-3 text-muted extra-small">
                                <i class="bi bi-journal-plus d-block h5 text-secondary mb-1"></i>
                                No variables defined yet.<br />Click <strong>+ Add Attribute</strong> to enter custom properties.
                            </div>
                        }
                        else
                        {
                            <div class="d-flex flex-column gap-2 mb-2">
                                @foreach (var entry in SelectedFeature.CustomEntries)
                                {
                                    <div class="d-flex align-items-center gap-1 bg-light p-2 rounded-3 border">
                                        <input type="text" class="form-control form-control-sm extra-small fw-bold"
                                               placeholder="Variable"
                                               value="@entry.Key"
                                               @onchange="(e) => UpdateEntryKey(entry, e.Value?.ToString())" />

                                        <span class="text-muted fw-bold">:</span>

                                        <input type="text" class="form-control form-control-sm extra-small"
                                               placeholder="Value"
                                               value="@entry.Value"
                                               @onchange="(e) => UpdateEntryValue(entry, e.Value?.ToString())" />

                                        <button type="button" class="btn btn-sm btn-outline-danger p-0 px-2 action-btn-small"
                                                @onclick="() => RemoveVariableRow(entry)"
                                                title="Delete variable">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                }
                            </div>
                        }

                        <div class="alert alert-info border-0 rounded-3 extra-small p-2 mb-0 d-flex align-items-center gap-2">
                            <i class="bi bi-info-circle-fill text-info h6 mb-0"></i>
                            <span>Attributes entered here will be saved to your plan upon clicking <strong>Save Plan</strong>.</span>
                        </div>
                    }
                    else
                    {
                        <!-- Read-Only Base Map Feature Properties View -->
                        @if (!SelectedFeature.Properties.Any())
                        {
                            <div class="text-center py-3 text-muted extra-small">
                                <i class="bi bi-info-circle d-block h5 text-secondary mb-1"></i>
                                No additional data table attributes recorded for this feature.
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive border rounded-3 bg-white">
                                <table class="table table-sm table-striped align-middle mb-0 extra-small">
                                    <thead class="table-light">
                                        <tr>
                                            <th class="fw-bold">Attribute</th>
                                            <th class="fw-bold">Value</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var kvp in SelectedFeature.Properties)
                                        {
                                            <tr>
                                                <td class="fw-semibold text-secondary text-truncate" style="max-width: 120px;" title="@kvp.Key">@kvp.Key</td>
                                                <td class="text-dark text-break">@kvp.Value</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    }
                }
            </div>
        </div>
    </div>
}
