@page "/"
@rendermode InteractiveServer

<PageTitle>Common Ground - Select Session & Connect</PageTitle>

<div class="home-container py-5">
    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold text-primary mb-2">Common Ground</h1>
    </div>

    <GameSessionSelector SelectedSessionId="@(SelectedSession?.Id ?? 0)" OnSessionSelected="HandleSessionSelected" />

    @if (SelectedSession != null)
    {
        <TeamConnectCard SelectedSession="SelectedSession" />
    }
    <div class="text-center">
        Version: @Version
    </div>
</div>
