@page "/creator"
@rendermode InteractiveServer

<PageTitle>Game Sessions - Creator Dashboard</PageTitle>

@if (!AuthState.IsAuthenticated)
{
    <div class="container py-4">
        @if (ShowRegister)
        {
            <RegisterCard OnRegisterSuccess="HandleLoginSuccess" OnShowLogin="() => ShowRegister = false" />
        }
        else
        {
            <LoginCard OnLoginSuccess="HandleLoginSuccess" OnShowRegister="() => ShowRegister = true" />
        }
    </div>
}
else
{
    <CreatorHeader />
    <div class="container pb-5">
        <GameSessionsOverview CurrentUser="AuthState.CurrentUser!" OnLogout="HandleLogout" />
    </div>
}
