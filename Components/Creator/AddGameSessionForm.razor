@namespace USPSimGame.Components.Creator

<div class="add-session-card card shadow-sm mb-4">
    <div class="card-header bg-light d-flex justify-content-between align-items-center">
        <h5 class="mb-0 text-primary"><i class="bi bi-plus-circle me-2"></i>Create New Game Session</h5>
        <button type="button" class="btn-close" @onclick="OnCancel"></button>
    </div>
    <div class="card-body">
        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="alert alert-danger" role="alert">
                <i class="bi bi-exclamation-circle me-2"></i>@ErrorMessage
            </div>
        }

        <EditForm Model="NewSession" OnValidSubmit="HandleSubmit">
            <DataAnnotationsValidator />

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label class="form-label font-weight-bold">Session Name</label>
                    <InputText class="form-control" @bind-Value="NewSession.Name" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label font-weight-bold">Center Coordinates (Lat, Long)</label>
                    <InputText class="form-control" @bind-Value="NewSession.CenterLatLong" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label font-weight-bold">Zoom Level</label>
                    <InputNumber class="form-control" @bind-Value="NewSession.Zoom" min="1" max="20" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label font-weight-bold">Start Year</label>
                    <InputNumber class="form-control" @bind-Value="NewSession.StartYear" required />
                </div>
            </div>

            <!-- Location Presets Helper -->
            <div class="bg-light p-3 rounded-3 border mb-3">
                <label class="form-label small fw-bold text-muted text-uppercase mb-2">
                    <i class="bi bi-geo-alt-fill text-primary me-1"></i>Quick Location Presets (Lat, Long):
                </label>
                <div class="d-flex flex-wrap gap-2">
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick='() => SetPreset("Hilversum", "52.22500, 5.18500")'>
                    <i class="bi bi-building me-1 text-primary"></i>Hilversum
                </button>
                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick='() => SetPreset("Arnhem", "51.98514, 5.89873")'>
                <i class="bi bi-building me-1 text-primary"></i>Arnhem
            </button>
            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick='() => SetPreset("Utrecht Science Park", "52.08640, 5.17516")'>
            <i class="bi bi-building me-1 text-primary"></i>Utrecht Science Park
        </button>
    </div>
</div>

<div class="d-flex justify-content-end gap-2 mt-4">
    <button type="button" class="btn btn-outline-secondary" @onclick="OnCancel" disabled="@IsSubmitting">
        Cancel
    </button>
    <button type="submit" class="btn btn-success" disabled="@IsSubmitting">
        @if (IsSubmitting)
        {
            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
            <span>Saving...</span>
        }
        else
        {
            <span><i class="bi bi-check-circle me-1"></i>Create Session</span>
        }
    </button>
</div>
</EditForm>
</div>
</div>