@namespace USPSimGame.Components.Creator
@using USPSimGame.Data.Entities

<div class="creator-overview-container">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="mb-1 text-dark"><i class="bi bi-controller me-2"></i>Game Sessions Overview</h2>
            <p class="text-muted mb-0">Manage active game sessions, pre-cached layers, simulator tags, and team credentials.</p>
        </div>
        <div>
            <button class="btn btn-primary" @onclick="ToggleAddForm">
                <i class="bi bi-plus-lg me-1"></i>@(ShowAddForm ? "Close Form" : "Add Game Session")
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@ErrorMessage
            <button type="button" class="btn-close" @onclick="() => ErrorMessage = null"></button>
        </div>
    }

    @if (ShowAddForm)
    {
        <AddGameSessionForm OnSessionAdded="HandleSessionAdded" OnCancel="ToggleAddForm" />
    }

    @if (IsLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading game sessions...</span>
            </div>
            <p class="text-muted mt-2">Loading game sessions...</p>
        </div>
    }
    else if (Sessions == null || !Sessions.Any())
    {
        <div class="card shadow-sm text-center py-5 px-4 empty-state-card">
            <div class="card-body">
                <i class="bi bi-inbox display-4 text-muted mb-3 d-block"></i>
                <h4 class="card-title text-secondary">No Game Sessions Found</h4>
                <p class="card-text text-muted">There are currently no game sessions registered in the database.</p>
                <button class="btn btn-primary mt-2" @onclick="ToggleAddForm">
                    <i class="bi bi-plus-lg me-1"></i>Create First Game Session
                </button>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>Name</th>
                            <th>Center (Long, Lat)</th>
                            <th>Map Layers</th>
                            <th>Teams</th>
                            <th>State</th>
                            <th>Created At</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var session in Sessions)
                        {
                            <tr>
                                <td><span class="badge bg-secondary">@session.Id</span></td>
                                <td><strong class="text-dark">@session.Name</strong></td>
                                <td><code>@session.CenterLatLong</code></td>
                                <td>
                                    <button class="btn btn-sm btn-outline-primary rounded-pill px-3 py-1 text-nowrap" @onclick="() => OpenSessionLayersModal(session)" title="Configure layers and simulator tags">
                                        <i class="bi bi-layers-fill me-1"></i>@session.MapLayers.Count Layer(s)
                                    </button>
                                </td>
                                <td>
                                    <button class="btn btn-sm btn-outline-secondary rounded-pill px-3 py-1 text-nowrap" @onclick="() => OpenSessionTeamsModal(session)" title="Manage team accounts and credentials">
                                        <i class="bi bi-people-fill me-1"></i>@session.Teams.Count Team(s)
                                    </button>
                                </td>
                                <td>
                                    <span class="badge @session.State.GetGameStateBadgeClass()">
                                        @session.State
                                    </span>
                                </td>
                                <td><small class="text-muted">@session.CreatedAt.ToString("g")</small></td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteSession(session.Id)" title="Delete game session">
                                        <i class="bi bi-trash me-1"></i>Delete
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@if (ShowLayersModal && SelectedSession != null)
{
    <SessionLayersModal Session="SelectedSession" OnClose="CloseSessionLayersModal" OnUpdated="LoadSessionsAsync" />
}

@if (ShowTeamsModal && SelectedSession != null)
{
    <SessionTeamsModal Session="SelectedSession" OnClose="CloseSessionTeamsModal" OnUpdated="LoadSessionsAsync" />
}
