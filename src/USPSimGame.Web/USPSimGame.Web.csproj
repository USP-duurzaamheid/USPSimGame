<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <Version>0.6.0</Version>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Blazor.Bootstrap" Version="3.5.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="OpenLayers.Blazor" Version="2.6.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\USPSimGame.Application\USPSimGame.Application.csproj" />
    <ProjectReference Include="..\USPSimGame.Infrastructure\USPSimGame.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="Data\Layers\**\*.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Update="Data\Teams\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
