@page "/join"
@layout PlayerLayout
@rendermode InteractiveServer

<PageTitle>Common Ground - Join</PageTitle>

<div class="join-main">
    <form class="join-card" @onsubmit="HandleJoin">
        <div class="join-card-header">
            <h1 class="join-card-title">PIN</h1>
            <p class="join-card-description">Join an active multiplayer simulation by entering the PIN from your host.</p>
        </div>

        <div class="join-pin @(ErrorMessage != null ? "join-pin--error" : null)">
            <div class="join-pin-slots">
                @for (var i = 0; i < PinLength; i++)
                {
                    var index = i;
                    var isActive = IsFocused && index == ActiveSlotIndex;
                    <div class="join-pin-slot @(isActive ? "join-pin-slot--active" : null)">
                        @if (index < Pin.Length)
                        {
                            @Pin[index]
                        }
                        else if (isActive)
                        {
                            <span class="join-pin-caret"></span>
                        }
                    </div>
                }
                <input @ref="pinInput"
                       class="join-pin-input"
                       type="text"
                       inputmode="numeric"
                       pattern="[0-9]*"
                       autocomplete="one-time-code"
                       maxlength="@PinLength"
                       aria-label="4-digit game code"
                       value="@Pin"
                       @oninput="HandlePinInputAsync"
                       @onfocus="() => IsFocused = true"
                       @onblur="() => IsFocused = false" />
            </div>
            <span class="join-pin-caption">@(ErrorMessage ?? "4-digit game code")</span>
        </div>

        <button type="submit" class="join-button" disabled="@(!IsPinComplete)">
            <span>JOIN</span>
            <i class="bi bi-arrow-right" aria-hidden="true"></i>
        </button>
    </form>
</div>
