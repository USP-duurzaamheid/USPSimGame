@namespace USPSimGame.Components.Game.Teams
@using USPSimGame.Components.Game.Hud

<HudStat Icon="bi-coin"
         Label="Campus Credits"
         Value="@CurrentBalance.ToString("N0")"
         Unit="CC"
         IsWarning="@(CurrentBalance < 0)"
         Title="@CreditsTooltip" />

@code {
    private string CreditsTooltip
    {
        get
        {
            var tooltip = $"Campus Credits: {CurrentBalance:N0} CC beschikbaar";
            if (MonthlyExpenseBurden > 0)
            {
                tooltip += $" · vaste lasten -{MonthlyExpenseBurden:N1} CC per maand";
            }
            return CurrentBalance < 0 ? $"{tooltip} · let op: je saldo is negatief!" : tooltip;
        }
    }
}
