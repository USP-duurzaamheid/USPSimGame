@namespace USPSimGame.Components.Game

<div class="geometry-draw-controls-container">
    @if (IsActive)
    {
        <!-- Mode Toggle & Drawing Controls -->
        <div class="d-flex align-items-center justify-content-between p-2 rounded-3 bg-white border">
            <small class="fw-semibold text-muted micro-text">
                <i class="bi bi-vector-pen me-1 text-primary"></i>Controls:
            </small>
            <div class="d-flex gap-1 align-items-center">
                <button type="button" class="btn btn-sm @(IsDrawingActive ? "btn-success" : "btn-outline-primary") py-0 px-2 rounded-pill undo-redo-btn"
                        @onclick="ToggleDrawingModeAsync"
                        title="@(IsDrawingActive ? "Pause drawing to inspect & edit data tables" : "Resume placing geometry points")">
                    <i class="bi @(IsDrawingActive ? "bi-pencil-fill" : "bi-cursor-fill") me-1"></i>
                    <span class="micro-text fw-bold">@(IsDrawingActive ? "Draw" : "Inspect")</span>
                </button>

                <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2 rounded-pill undo-redo-btn" @onclick="UndoAsync" title="Undo point">
                    <i class="bi bi-arrow-counterclockwise text-primary"></i>
                </button>

                <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2 rounded-pill undo-redo-btn" @onclick="RedoAsync" title="Redo point">
                    <i class="bi bi-arrow-clockwise text-primary"></i>
                </button>

                <button type="button" class="btn btn-sm btn-outline-danger py-0 px-2 rounded-pill undo-redo-btn" @onclick="DeletePointAsync" title="Click a point on map to select, then click here to delete">
                    <i class="bi bi-trash"></i>
                </button>
            </div>
        </div>

        <div class="alert alert-info border-0 rounded-3 small p-2 mt-2 mb-0 d-flex align-items-center gap-2">
            <i class="bi bi-info-circle-fill text-info h6 mb-0"></i>
            <span class="micro-text">Click directly on the map to draw shape geometry. Drag any vertex to edit shapes.</span>
        </div>
    }
</div>
