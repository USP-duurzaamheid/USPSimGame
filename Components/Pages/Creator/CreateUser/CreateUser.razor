@page "/create-user"
@rendermode InteractiveServer
@inject ILogger<Program> logger;

<PageTitle>Create User</PageTitle>

<p>Sample create user form</p>


<EditForm Model="MyDog" OnSubmit="LogicFunction" FormName="Onnodig">
    <div>
        <label>
            Identifier:
            <InputText @bind-Value="MyDog!.Id" />
        </label>
    </div>
    <div>
        <button type="submit">Submit</button>
    </div>


@if(IsSend)
    {
        <div>Form has been sent, waiting for result</div>
    }

</EditForm>



