@namespace USPSimGame.Components.Game.ControlBarFiles
@using USPSimGame.Data.Enums

@{
    var session = PlayerSessionState.CurrentGameSession;
    var team = PlayerSessionState.CurrentTeam;
}

<!-- Control bar: team, team values, game state, date and exit -->
<header class="control-bar" aria-label="Spelstatus">
    <div class="control-bar-logo" title="Common Ground">
        <i class="bi bi-globe2" aria-hidden="true"></i>
    </div>

    <div class="control-bar-stats">
        @if (PlayerSessionState.IsAdmin)
        {
            <div class="control-bar-item">
                <span class="control-bar-admin-badge" aria-hidden="true"><i class="bi bi-shield-lock-fill"></i></span>
                <span class="control-bar-text">@PlayerSessionState.CurrentAdminUser?.Username</span>
                <span class="control-bar-role">Game Admin</span>
            </div>
        }
        else if (team != null)
        {
            <div class="control-bar-item" title="@PlayerSessionState.CurrentPlayerSession?.UserName speelt voor @TeamLabel(team.Name)">
                <TeamBadge Name="@team.Name" Color="@team.Color" />
                <span class="control-bar-text control-bar-team-name">@TeamLabel(team.Name)</span>
            </div>
            <div class="control-bar-item">
                <Stat Icon="bi-star" Label="Duurzaamheidspunten"
                         Value="@SustainabilityPoints.ToString()" Unit="pts" IsPreview="true" />
            </div>
            <div class="control-bar-item">
                <StatTeamInfo TeamId="@team.Id" />
            </div>
            <div class="control-bar-item">
                <Stat Icon="bi-lightning-charge-fill" IconStyle="StatIconStyle.Accent" Label="Duurzame elektriciteit"
                         Value="@RenewableElectricityPercent.ToString()" Unit="%" IsPreview="true" />
            </div>
            <div class="control-bar-item">
                <StatDisruption NoisePollution="@NoisePollution" IsPreview="true" />
            </div>
            <div class="control-bar-item">
                <Stat Icon="bi-emoji-angry-fill" IconStyle="StatIconStyle.Plain" Label="Boetes" Caption="Boete"
                         Value="@FineCount.ToString()" Title="Aantal Campus Credit-boetes voor gemiste deadlines" IsPreview="true" />
            </div>
        }
    </div>

    <div class="control-bar-end">
        @if (session != null)
        {
            <div class="control-bar-item">
                @if (PlayerSessionState.IsAdmin)
                {
                    <button type="button" class="control-bar-state control-bar-state--button" @onclick="ToggleStateControlPanel" title="Spelstatus en timer beheren">
                        @session.State.ToString().ToUpperInvariant()
                        <i class="bi bi-sliders" aria-hidden="true"></i>
                    </button>
                }
                else
                {
                    <span class="control-bar-state">@session.State.ToString().ToUpperInvariant()</span>
                }

                @if ((session.State == GameState.Play || session.State == GameState.Pause) && !string.IsNullOrEmpty(RemainingTimeFormatted))
                {
                    <span class="control-bar-timer" title="@(session.State == GameState.Pause ? "Timer gepauzeerd" : "Resterende tijd deze maand")">
                        <i class="bi bi-stopwatch" aria-hidden="true"></i>@RemainingTimeFormatted
                    </span>
                }
            </div>
            <div class="control-bar-item">
                <span class="control-bar-text" title="Huidige speldatum">01 @FormattedGameDate</span>
            </div>
        }

        <button type="button" class="control-bar-exit" @onclick="Disconnect">
            <i class="bi bi-box-arrow-right" aria-hidden="true"></i>
            <span>EXIT</span>
        </button>
    </div>
</header>

<!-- Admin Center Modal: Game State Controls -->
@if (ShowStateControlPanel && PlayerSessionState.CurrentGameSession != null)
{
    <div class="game-state-modal-backdrop position-fixed top-0 start-0 w-100 h-100 bg-dark bg-opacity-50 d-flex align-items-center justify-content-center">
        <div class="card border-0 shadow-lg rounded-4 overflow-hidden" style="width: 440px; max-width: calc(100vw - 32px);">
            <div class="card-header bg-transparent border-bottom p-3 d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-sliders text-primary fs-5"></i>
                    <h6 class="fw-bold text-dark mb-0">Game State & Timer Control Panel</h6>
                </div>
                <button type="button" class="btn-close" @onclick="ToggleStateControlPanel" title="Close panel"></button>
            </div>

            <div class="card-body p-4 text-center">
                <div class="mb-3">
                    <span class="text-uppercase text-muted fw-bold extra-small d-block mb-1">Current State</span>
                    <span class="badge @PlayerSessionState.CurrentGameSession.State.GetGameStateBadgeClass() fs-5 px-3 py-2">
                        @PlayerSessionState.CurrentGameSession.State
                    </span>
                </div>

                <div class="bg-light p-3 rounded-3 mb-4 border text-start">
                    <label class="form-label fw-bold text-dark small mb-2">
                        <i class="bi bi-stopwatch text-primary me-1"></i>Month Duration in Play Phase
                    </label>
                    <div class="row g-2 align-items-center">
                        <div class="col-4">
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-white text-muted">Min</span>
                                <input type="number" class="form-control" min="0" max="60" @bind="DurationMinutes" />
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-white text-muted">Sec</span>
                                <input type="number" class="form-control" min="0" max="59" step="5" @bind="DurationSeconds" />
                            </div>
                        </div>
                        <div class="col-4">
                            <button type="button" class="btn btn-sm btn-outline-primary w-100 fw-semibold" @onclick="ApplyDurationAsync">
                                <i class="bi bi-check2 me-1"></i>Apply
                            </button>
                        </div>
                    </div>
                    <small class="text-muted extra-small d-block mt-1">Each month will automatically countdown for this duration when in Play state.</small>
                </div>

                <div class="d-flex flex-column gap-3">
                    <button type="button" class="btn btn-warning btn-lg rounded-3 py-2 fw-bold d-flex align-items-center justify-content-center gap-2"
                            @onclick="() => ChangeGameStateAsync(GameState.Pause)"
                            disabled="@(PlayerSessionState.CurrentGameSession.State == GameState.Pause)">
                        <i class="bi bi-pause-circle-fill fs-4"></i> Pause Game Session
                    </button>

                    <button type="button" class="btn btn-success btn-lg rounded-3 py-2 fw-bold d-flex align-items-center justify-content-center gap-2"
                            @onclick="() => ChangeGameStateAsync(GameState.Play)"
                            disabled="@(PlayerSessionState.CurrentGameSession.State == GameState.Play)">
                        <i class="bi bi-play-circle-fill fs-4"></i> Play Game Session
                    </button>

                    <button type="button" class="btn btn-outline-secondary btn-sm rounded-3 py-2 fw-semibold d-flex align-items-center justify-content-center gap-2 mt-2"
                            @onclick="() => ChangeGameStateAsync(GameState.Setup)"
                            disabled="@(PlayerSessionState.CurrentGameSession.State == GameState.Setup)">
                        <i class="bi bi-gear-fill"></i> Reset to Setup Phase
                    </button>
                </div>
            </div>

            <div class="card-footer bg-transparent border-top p-3 text-end">
                <button type="button" class="btn btn-secondary rounded-pill px-4" @onclick="ToggleStateControlPanel">
                    Close
                </button>
            </div>
        </div>
    </div>
}
