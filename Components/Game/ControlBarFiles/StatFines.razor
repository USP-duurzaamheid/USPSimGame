@namespace USPSimGame.Components.Game.ControlBarFiles

<StatPanel Title="Fines" Subtitle="@Subtitle">
    <StatContent>
        <Stat Icon="bi-emoji-angry-fill"
              IconStyle="StatIconStyle.Plain"
              Label="Fines"
              Caption="Fine"
              Value="@ActiveCount.ToString()"
              IsWarning="@(ActiveCount > 0)"
              IsPreview="@IsPreview"
              Title="Fines for missed deadlines, click for details" />
    </StatContent>
    <ChildContent>
        @if (!Fines.Any())
        {
            <p class="fines-empty">
                <i class="bi bi-check2-circle" aria-hidden="true"></i>
                You have not received any fines yet.
            </p>
        }
        else
        {
            <ul class="fines-list">
                @foreach (var fine in OrderedFines)
                {
                    <li class="fine @(fine.IsActive ? null : "fine--stopped")">
                        <div class="fine-header">
                            <span class="fine-code">@fine.DilemmaCode</span>
                            <span class="fine-title">@fine.DilemmaTitle</span>
                        </div>
                        <p class="fine-reason">@fine.Reason</p>
                        <div class="fine-footer">
                            <span class="fine-amount">-@fine.AmountCredits CC per month</span>
                            <span class="fine-status">@GetStatusLabel(fine)</span>
                        </div>
                    </li>
                }
            </ul>
        }

        @if (IsPreview)
        {
            <p class="fines-preview-note">Sample data: will be replaced by the real fines from the game.</p>
        }
    </ChildContent>
</StatPanel>
